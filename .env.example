# Dialogue System Builder configuration. Copy to .env beside server.py, which loads it in both text and voice mode.
# The servers in examples/flow-viewer do not load .env and read the shell environment only.

# --- Language model. Configure one provider. Azure OpenAI takes precedence if both keys are set.
# IL includes clients for the OpenAI API format and Azure OpenAI only, because one client handles every reply and analyzer call and most providers can be reached through the OpenAI format with OPENAI_BASE_URL.
# Providers without that format require a new client in IL.
OPENAI_API_KEY=
OPENAI_MODEL=                 # Model name, e.g. gpt-4o-mini
OPENAI_BASE_URL=              # Required, e.g. https://api.openai.com/v1

AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=        # https://<resource>.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=      # Deployment name, not model name
AZURE_OPENAI_API_VERSION=     # e.g. 2024-10-21

# --- Azure Speech. Required for Start with voice, for TTS and the list of voices, with IL's pipecat extra installed.
# Azure Speech is the default because it provides the interim STT results for the incremental analyzers and the word timings for the spoken text. It was also the service used in development.
# Other TTS services can replace it, but only by writing code that supplies the same data, so they are not offered as settings here.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=          # e.g. westeurope

# --- Other STT vendors. Azure is the default, and python server.py --stt chooses elevenlabs, openai or whisper instead.
# Only these are listed because each vendor is an explicit branch in IL's PipecatSTTService. Any other Pipecat service can be added there if it emits InterimTranscriptionFrame and TranscriptionFrame.
# Without interim results, as with whisper, conversations work but incremental analyzers receive no input.
# openai and whisper use OPENAI_API_KEY.
ELEVENLABS_API_KEY=           # The secret starting with sk, not the key ID

# --- WebRTC relays. Optional, for browsers that cannot reach the server directly.
STUN_URL=                     # stun:<host>:<port>
TURN_URL=                     # turn://<username>:<credential>@<host>:<port>

# --- Azure Cosmos DB. Optional, only when memory_vendor in dialogue_system_builder/mounts.py is set to "cosmos". Requires IL's cosmos extra.
COSMOS_ENDPOINT=              # https://<account>.documents.azure.com:443/
COSMOS_KEY=
COSMOS_DATABASE=

# --- Where sessions, flows and testing links are kept. Optional. Defaults to data/ beside server.py, and python server.py --data overrides it.
DIALOGUE_SYSTEM_BUILDER_DATA=
